# 環境變數範例檔案
# 複製此檔案為 .env 並填入實際的值
# 注意：.env 檔案應該加入 .gitignore，避免將敏感資訊提交到版本控制

# API 設定
API_KEY=your_api_key_here

# 資料庫設定
DATABASE_URL=mongodb://username:password@localhost:27017/game

# 應用程式設定
NODE_ENV=development
PORT=3000

# 其他敏感設定
JWT_SECRET=your_jwt_secret_here
ENCRYPTION_KEY=your_encryption_key_here